.venv/
node_modules
__pycache__/
.pytest_cache/
*.egg-info/
data/local/
outputs/*/previews/
.DS_Store

# Source-rich historical outputs stay local; publish aggregate diagnostics only.
outputs/*
!outputs/encoder_consistency/
outputs/encoder_consistency/*
!outputs/encoder_consistency/*.md
!outputs/encoder_consistency/*.json
!outputs/encoder_consistency/*.csv
!outputs/encoder_consistency/*.png
!outputs/encoder_consistency/*.svg
!outputs/candidate_pool/
outputs/candidate_pool/*
!outputs/candidate_pool/*.md
!outputs/candidate_pool/*.json

# Blank collection workbooks are shareable deliverables: they contain no
# third-party records, and scripts/build_template.mjs needs a non-public package.
!outputs/bioreaction_atlas_v01/
outputs/bioreaction_atlas_v01/*
!outputs/bioreaction_atlas_v01/*.xlsx
!outputs/bioreaction_atlas_v02/
outputs/bioreaction_atlas_v02/*
!outputs/bioreaction_atlas_v02/*.xlsx
tmp/
.env
.env.*
!.env.example
