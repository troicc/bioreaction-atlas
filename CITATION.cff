  # A DOI record cannot be edited after minting.
  - given-names: REPLACE_ME
    family-names: REPLACE_ME
    alias: troicc
repository-code: "https://github.com/troicc/bioreaction-atlas"
license: Apache-2.0
version: 0.2.0
date-released: "2026-09-12"
keywords:
